# --- LLM (set at least one provider; switch with LLM_PROVIDER, no code change) ---
LLM_PROVIDER=gemini            # gemini | groq | openrouter | ollama | anthropic
GEMINI_API_KEY=
# optional: a key from a second Google project, used once the first key's free daily quota is spent
GEMINI_API_KEY_FALLBACK=
# optional: a third project's key, tried after the first fallback (up to _5)
GEMINI_API_KEY_FALLBACK_2=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional overrides:
#   LLM_PROVIDER_PROMISE_VS_DELIVERY=anthropic   (route one task to another provider)
#   LLM_MODEL_GEMINI_FAST=<model-id>             (override a provider's model for a tier)

# --- API ---
FINN_DEMO_PASSCODE=
ALLOWED_ORIGINS=http://localhost:3000

# --- Paths (defaults are fine locally) ---
# FINN_DATA_DIR=./data
# FINN_CACHE_DIR=./cache
# FINN_MIN_REQ_INTERVAL=1.0
